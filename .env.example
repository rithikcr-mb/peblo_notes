# Database
DATABASE_URL=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google Gemini AI
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: Node environment
NODE_ENV=development

# Neon Postgres (recommended for serverless)
# Append this to DATABASE_URL for production/serverless deployments:
# ?pgbouncer=true&connect_timeout=10